{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CineForge",
  "version": "0.1.0",
  "identifier": "com.cineforge.app",
  "build": {
    "beforeDevCommand": "npm run dev -w @cineforge/web",
    "beforeBuildCommand": "npm run build -w @cineforge/web",
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CineForge",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
