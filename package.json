{
  "name": "cineforge-monorepo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cineforge/web",
    "dev:web": "npm run dev -w @cineforge/web",
    "dev:mobile": "npm run dev -w @cineforge/mobile",
    "build": "npm run build -w @cineforge/web && npm run build -w @cineforge/mobile",
    "build:web": "npm run build -w @cineforge/web",
    "build:mobile": "npm run build -w @cineforge/mobile",
    "lint": "npm run lint -ws --if-present",
    "preview": "npm run preview -w @cineforge/web",
    "tauri:dev": "npm run tauri:dev -w @cineforge/web",
    "tauri:build": "npm run tauri:build -w @cineforge/web"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
